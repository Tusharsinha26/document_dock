# ==============================================================================
# DocumentDock Production Environment Variables (Vercel / Cloud Deployment)
# ==============================================================================
# Copy these variable names into your Vercel Project -> Settings -> Environment Variables.
# NEVER commit real passwords, database URLs, or SECRET_KEY values to GitHub!

# 1. Django Security Key (Required in production - generate a random 50+ char string)
SECRET_KEY=replace-with-a-long-random-secret-key

# 2. Production Debug Flag (MUST be False in production)
DEBUG=False

# 3. Allowed Hosts (Comma-separated hostnames; .vercel.app is included automatically)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# 4. PostgreSQL Database URL (Recommended for persistent users & sessions on Vercel)
# Example (Neon / Supabase / Vercel Postgres):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# 5. MongoDB Atlas Cloud Connection String (Recommended for persistent documents & file uploads)
# Get this from MongoDB Atlas -> Connect -> Drivers -> Python
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# 6. MongoDB Database Name
MONGODB_DB_NAME=documentdock_db

# 7. Optional Custom Domain CSRF Origins (comma-separated, if you attach a custom domain)
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.com
