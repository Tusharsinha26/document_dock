# ==============================================================================
# DocumentDock Production Environment Variables
# ==============================================================================
# Copy and set these values in Render's "Environment" settings tab.
# NEVER commit your real database passwords or SECRET_KEY to GitHub!

# 1. Django Security Key (Use a long random string; Render can also auto-generate this)
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key-in-production

# 2. Production Debug Flag (MUST be False in production)
DEBUG=False

# 3. Allowed Hosts (Comma-separated hostnames)
# Render automatically handles your *.onrender.com URL, but you can specify it here:
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# 4. MongoDB Atlas Cloud Connection String
# Get this from MongoDB Atlas -> Connect -> Drivers -> Python
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# 5. MongoDB Database Name
MONGODB_DB_NAME=documentdock_db

# 6. Optional Custom Domain CSRF Origins (if you attach a custom domain later)
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.com

